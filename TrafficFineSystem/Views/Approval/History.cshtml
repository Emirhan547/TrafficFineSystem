
@model List<ApprovalHistoryDto>

@{
    ViewData["Title"] = "Onay Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Onay Geçmişi</h2>

    <a asp-controller="TrafficFine" asp-action="Index"class="btn btn-secondary">Trafik Cezalarına Dön</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Bu trafik cezasına ait herhangi bir onay işlemi bulunmamaktadır.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>İşlem</th>
                    <th>Önceki Durum</th>
                    <th>Yeni Durum</th>
                    <th>Açıklama</th>
                    <th>Tarih</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var history in Model)
                {
                    <tr>
                        <td>
                            @history.UserEmail
                        </td>

                        <td>
                            @history.Action
                        </td>

                        <td>
                            @history.PreviousStatus
                        </td>

                        <td>
                            @history.NewStatus
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(history.Description)
                                ? "-"
                                : history.Description)
                        </td>

                        <td>
                            @history.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}