@model List<TrafficFineSystem.Dtos.TrafficFineDtos.TrafficFineListDto>

@{
    ViewData["Title"] = "Onaylar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Onaylar</h2>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz kayıtlı trafik cezası bulunmamaktadır.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Plaka</th>
                    <th>Tutar</th>
                    <th>Ceza Tarihi</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var trafficFine in Model)
                {
                    <tr>
                        <td>
                            @trafficFine.Plate
                        </td>

                        <td>
                            @trafficFine.Amount.ToString("N2") ₺
                        </td>

                        <td>
                            @trafficFine.FineDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @trafficFine.Status
                        </td>

                        <td>

                            <a asp-controller="TrafficFine"
                               asp-action="Details"
                               asp-route-id="@trafficFine.Id"
                               class="btn btn-sm btn-primary">
                                Detay
                            </a>

                            @if (User.IsInRole("Manager") &&
                                 trafficFine.Status == TrafficFineSystem.Data.Enums.FineStatus.New)
                            {
                                <a asp-controller="TrafficFine"
                                   asp-action="Details"
                                   asp-route-id="@trafficFine.Id"
                                   class="btn btn-sm btn-success">
                                    Onayla / Reddet
                                </a>
                            }

                            @if (User.IsInRole("Finance") &&
                                 trafficFine.Status == TrafficFineSystem.Data.Enums.FineStatus.ManagerApproved)
                            {
                                <a asp-controller="TrafficFine"
                                   asp-action="Details"
                                   asp-route-id="@trafficFine.Id"
                                   class="btn btn-sm btn-success">
                                    Onayla / Reddet
                                </a>
                            }

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}