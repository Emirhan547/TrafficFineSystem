@model List<VehicleTrafficFineDto>

@{
    ViewData["Title"] = "Onaylar";
}

<h2 class="mb-4">Onaylar</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz kayıtlı trafik cezası bulunmamaktadır.
    </div>
}
else
{
    <div class="accordion" id="approvalAccordion">

        @foreach (var vehicle in Model)
        {
            var collapseId = $"approval-vehicle-{vehicle.VehicleId}";

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"type="button"data-bs-toggle="collapse"data-bs-target="#@collapseId">

                        <strong class="me-3">@vehicle.Plate </strong>
                        <span class="text-muted">@vehicle.Brand @vehicle.Model· @vehicle.TrafficFines.Count ceza </span>

                    </button>

                </h2>

                <div id="@collapseId"class="accordion-collapse collapse">

                    <div class="accordion-body">

                        <table class="table table-striped table-hover mb-0">

                            <thead>
                                <tr>
                                    <th>Tutar</th>
                                    <th>Ceza Tarihi</th>
                                    <th>Durum</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var trafficFine in vehicle.TrafficFines)
                                {
                                    <tr>

                                        <td>
                                            @trafficFine.Amount.ToString("N2") ₺
                                        </td>

                                        <td>
                                            @trafficFine.FineDate.ToString("dd.MM.yyyy")
                                        </td>

                                        <td>
                                            @trafficFine.Status
                                        </td>

                                        <td>

                                            <a asp-controller="TrafficFine"asp-action="Details"asp-route-id="@trafficFine.Id"class="btn btn-sm btn-primary">Detay</a>

                                            <a asp-controller="Approval"asp-action="History"asp-route-trafficFineId="@trafficFine.Id"class="btn btn-sm btn-outline-secondary">Geçmiş</a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }

    </div>
}