@model UpdateTrafficFineDto

@{
    ViewData["Title"] = "Trafik Cezası Düzenle";

    var vehicles =ViewBag.Vehicles as List<VehicleListDto>;
}

<h2>Trafik Cezası Düzenle</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="VehicleId"
               class="form-label">
            Araç
        </label>

        <select asp-for="VehicleId"
                class="form-select">

            <option value="0">
                Araç seçiniz
            </option>

            @if (vehicles is not null)
            {
                foreach (var vehicle in vehicles)
                {
                    <option value="@vehicle.Id">
                        @vehicle.Plate -
                        @vehicle.Brand @vehicle.Model
                    </option>
                }
            }

        </select>

        <span asp-validation-for="VehicleId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount"
               class="form-label">
            Ceza Tutarı
        </label>

        <input asp-for="Amount"
               type="number"
               step="0.01"
               class="form-control" />

        <span asp-validation-for="Amount"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="FineDate"
               class="form-label">
            Ceza Tarihi
        </label>

        <input asp-for="FineDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="FineDate"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
            Açıklama
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Güncelle
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Vazgeç
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}