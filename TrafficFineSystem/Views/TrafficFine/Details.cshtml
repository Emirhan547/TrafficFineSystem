@model TrafficFineSystem.Dtos.TrafficFineDtos.TrafficFineDetailDto

@{
    ViewData["Title"] = "Trafik Cezası Detayı";
}

<h2>Trafik Cezası Detayı</h2>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Plaka</dt>
            <dd class="col-sm-9">@Model.Plate</dd>

            <dt class="col-sm-3">Marka</dt>
            <dd class="col-sm-9">@Model.Brand</dd>

            <dt class="col-sm-3">Model</dt>
            <dd class="col-sm-9">@Model.Model</dd>

            <dt class="col-sm-3">Ceza Tutarı</dt>
            <dd class="col-sm-9">
                @Model.Amount.ToString("N2") ₺
            </dd>

            <dt class="col-sm-3">Ceza Tarihi</dt>
            <dd class="col-sm-9">
                @Model.FineDate.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">
                @Model.Description
            </dd>

        </dl>

        @if (Model.Status == TrafficFineSystem.Data.Enums.FineStatus.New)
        {
            <a asp-action="Edit"asp-route-id="@Model.Id"class="btn btn-warning">Düzenle</a>
        }

        <a asp-action="Index"class="btn btn-secondary">Listeye Dön</a>

        <a asp-controller="Approval"asp-action="History" asp-route-trafficFineId="@Model.Id"class="btn btn-outline-secondary">Onay Geçmişi</a>

    </div>
</div>

@if (User.IsInRole("Manager") && Model.Status == TrafficFineSystem.Data.Enums.FineStatus.New)
{
    <div class="card mt-4">
        <div class="card-body">

            <h5>Yönetici Onayı</h5>

            <form asp-controller="Approval" asp-action="Approve"method="post">

                <input type="hidden" name="TrafficFineId"value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">Açıklama
                        <span class="text-muted">(Opsiyonel)</span>
                    </label>

                    <textarea name="Description"class="form-control"rows="3"placeholder="Onay ile ilgili bir açıklama yazabilirsiniz."></textarea>
                </div>

                <button type="submit"class="btn btn-success">Onayla </button>

                <button type="button"class="btn btn-danger"data-bs-toggle="modal"data-bs-target="#rejectModal">Reddet</button>

            </form>

        </div>
    </div>
}

@if (User.IsInRole("Finance") &&
     Model.Status == TrafficFineSystem.Data.Enums.FineStatus.ManagerApproved)
{
    <div class="card mt-4">
        <div class="card-body">

            <h5>Finans Onayı</h5>

            <form asp-controller="Approval"asp-action="Approve"method="post">

                <input type="hidden"name="TrafficFineId"value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label"> Açıklama<span class="text-muted">(Opsiyonel)</span> </label>

                    <textarea name="Description"class="form-control"rows="3"placeholder="Onay ile ilgili bir açıklama yazabilirsiniz."></textarea>
                </div>

                <button type="submit"class="btn btn-success">Onayla </button>

                <button type="button"class="btn btn-danger"data-bs-toggle="modal"data-bs-target="#rejectModal"> Reddet </button>

            </form>

        </div>
    </div>
}

<div class="modal fade"id="rejectModal"tabindex="-1"aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Trafik Cezasını Reddet</h5>

                <button type="button"class="btn-close"data-bs-dismiss="modal"></button>
            </div>

            <form asp-controller="Approval"asp-action="Reject"method="post">

                <div class="modal-body">

                    <input type="hidden" name="TrafficFineId"value="@Model.Id" />

                    <div class="mb-3">

                        <label class="form-label">Ret Nedeni</label>

                        <textarea name="Description"class="form-control"rows="4"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary"data-bs-dismiss="modal">Vazgeç</button>

                    <button type="submit"class="btn btn-danger"> Reddet </button>

                </div>

            </form>

        </div>

    </div>
</div>