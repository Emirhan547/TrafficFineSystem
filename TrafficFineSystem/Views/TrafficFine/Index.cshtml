@model List<VehicleTrafficFineDto>

@{
    ViewData["Title"] = "Trafik Cezaları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Trafik Cezaları</h2>

    <a asp-action="Create"class="btn btn-primary"> Yeni Trafik Cezası</a>
</div>



@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz kayıtlı trafik cezası bulunmamaktadır.
    </div>
}
else
{
    <div class="accordion" id="vehicleAccordion">

        @foreach (var vehicle in Model)
        {
            var collapseId = $"vehicle-{vehicle.VehicleId}";

            <div class="accordion-item">

                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"type="button"data-bs-toggle="collapse"data-bs-target="#@collapseId">

                        <strong class="me-3">@vehicle.Plate</strong>

                        <span class="text-muted">@vehicle.Brand @vehicle.Model· @vehicle.TrafficFines.Count ceza</span>

                    </button>
                </h2>

                <div id="@collapseId"class="accordion-collapse collapse">

                    <div class="accordion-body">

                        <table class="table table-striped table-hover mb-0">

                            <thead>
                                <tr>
                                    <th>Tutar</th>
                                    <th>Ceza Tarihi</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var trafficFine in vehicle.TrafficFines)
                                {
                                    <tr>

                                        <td>
                                            @trafficFine.Amount.ToString("N2") ₺
                                        </td>
                                        <td>
                                            @trafficFine.FineDate.ToString("dd.MM.yyyy")
                                        </td>
                                        <td>
                                            @trafficFine.Status
                                        </td>

                                        <td>

                                            <a asp-action="Details"asp-route-id="@trafficFine.Id"class="btn btn-sm btn-info">Detay</a>

                                            @if (trafficFine.Status ==TrafficFineSystem.Data.Enums.FineStatus.New)
                                            {
                                                <a asp-action="Edit"asp-route-id="@trafficFine.Id"class="btn btn-sm btn-warning">Düzenle</a>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

            </div>
        }

    </div>
}