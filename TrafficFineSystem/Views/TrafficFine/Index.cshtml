@model List<TrafficFineListDto>

@{
    ViewData["Title"] = "Trafik Cezaları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Trafik Cezaları</h2>

    <a asp-action="Create" class="btn btn-primary">
        Yeni Trafik Cezası
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz kayıtlı trafik cezası bulunmamaktadır.
    </div>
}
else
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Plaka</th>
                <th>Tutar</th>
                <th>Ceza Tarihi</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var trafficFine in Model)
            {
                <tr>
                    <td>
                        @trafficFine.Plate
                    </td>

                    <td>
                        @trafficFine.Amount.ToString("N2") ₺
                    </td>

                    <td>
                        @trafficFine.FineDate.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @trafficFine.Status
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@trafficFine.Id"
                           class="btn btn-sm btn-info">
                            Detay
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@trafficFine.Id"
                           class="btn btn-sm btn-warning">
                            Düzenle
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
}